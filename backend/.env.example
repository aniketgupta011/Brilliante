
# ─────────────────────────────────────────────
#  Brillianté Chess Club — Environment Variables
#  Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/chess_club

# ── JWT Auth ──────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_real_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Email (fastapi-mail) ──────────────────────
# Option A: Gmail SMTP
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=youraddress@gmail.com
#   MAIL_PASSWORD=your_app_password   (16-char app password from Google Account)
#   MAIL_FROM=youraddress@gmail.com
#   MAIL_FROM_NAME=Brillianté Chess Club
#   MAIL_STARTTLS=True
#   MAIL_SSL_TLS=False

# Option B: Resend SMTP relay
#   MAIL_SERVER=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=re_your_resend_api_key
#   MAIL_FROM=onboarding@resend.dev
#   MAIL_FROM_NAME=Brillianté Chess Club
#   MAIL_STARTTLS=True
#   MAIL_SSL_TLS=False

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Brillianté Chess Club
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# ── App Settings ──────────────────────────────
# Comma-separated origins allowed by CORS (your static frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500
